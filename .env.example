# Optional connections. The studio works locally without any keys.
# These flags are declarations, not remote billing checks. Leave hosted providers
# disabled unless the account genuinely has no paid usage enabled.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_FREE_ACCOUNT_ONLY=0
HF_TOKEN=
HF_FREE_ACCOUNT_ONLY=0
GEMINI_API_KEY=
GEMINI_FREE_ACCOUNT_ONLY=0
# Optional local text-only art direction, requires `ollama pull qwen2.5:3b`.
OLLAMA_ENABLED=0
# STUDIO_DATA=/absolute/path/to/private/storage
